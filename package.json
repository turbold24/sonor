{
  "name": "sonor",
  "version": "0.0.1",
  "description": "Mongolian-language AI sales agent for small businesses on Facebook Messenger",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @sonor/api start:dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @sonor/api start:prod",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @sonor/api db:generate",
    "db:migrate": "pnpm --filter @sonor/api db:migrate",
    "db:deploy": "pnpm --filter @sonor/api db:deploy",
    "db:seed": "pnpm --filter @sonor/api db:seed",
    "db:reset": "pnpm --filter @sonor/api db:reset",
    "db:studio": "pnpm --filter @sonor/api db:studio",
    "model:smoke": "pnpm --filter @sonor/api model:smoke",
    "agent:eval": "pnpm --filter @sonor/api agent:eval",
    "tenant:connect-page": "pnpm --filter @sonor/api tenant:connect-page"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
