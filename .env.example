# Copy to .env and adjust. Never commit .env.

# API
NODE_ENV=development
PORT=3000

# Local Postgres (docker-compose.yml)
# Host port defaults to 5433 so it doesn't clash with a Postgres already on 5432.
POSTGRES_USER=sonor
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sonor
POSTGRES_PORT=5433
DATABASE_URL=postgresql://sonor:change-me@localhost:5433/sonor?schema=public

# Encrypts Page access tokens and platform API keys at rest.
# 32 random bytes, base64. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32

# Model: Muse Spark on Meta Model API (Responses API, https://dev.meta.ai/docs)
MODEL_PROVIDER=meta
# muse-spark-1.3 is Standard mode (your content isn't used for training).
# muse-spark-1.3-contributor is much cheaper but lets Meta train on customer chats.
MODEL_ID=muse-spark-1.3
MODEL_BASE_URL=https://api.meta.ai/v1
# Create one in the Model API dashboard (keys start with LLM_). Leave empty to run without the model.
MODEL_API_KEY=
# Optional: only when MODEL_BASE_URL points at Sonor's model relay (relay/). Shared secret,
# sent as X-Relay-Secret; the relay's Vercel project has the same value as RELAY_SECRET.
MODEL_RELAY_SECRET=
# Per HTTP attempt. Only 429 and 5xx (except 504) are retried.
MODEL_TIMEOUT_MS=60000
MODEL_MAX_RETRIES=2
# Includes reasoning tokens. 16 to 131072.
MODEL_MAX_OUTPUT_TOKENS=4096
# minimal, low, medium, high, xhigh or max. Higher is slower and costs more.
MODEL_REASONING_EFFORT=low
# Tokens per tenant per UTC day. New model calls are refused once it's reached.
DAILY_TOKEN_LIMIT=500000

# Messenger webhook. Requests are rejected until the verify token and app secret are set.
# Any random string; enter the same value as the Verify Token in the Meta app dashboard.
# Generate one with: openssl rand -hex 16
MESSENGER_VERIFY_TOKEN=
# Meta app dashboard: App settings > Basic > App secret.
MESSENGER_APP_SECRET=
# Optional: the Meta app ID, so echoes of Sonor's own replies are recognized by app ID too.
MESSENGER_APP_ID=
GRAPH_API_VERSION=v26.0
# How long the bot stays silent after the owner replies by hand or a handoff, before resuming.
BOT_PAUSE_HOURS=12
# Public HTTPS address of this API, used in payment links (your tunnel URL locally).
# Defaults to http://localhost:PORT, which only works in a browser on this machine.
PUBLIC_BASE_URL=
# Page access tokens are stored per tenant (encrypted) with pnpm tenant:connect-page, not here.

# PLATFORM tenants: per-request timeout for the platform integration API.
# Each tenant's base URL and API key are stored encrypted on the Tenant row, not here.
PLATFORM_TIMEOUT_MS=8000
