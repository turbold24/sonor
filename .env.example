# Copy to .env and adjust. Never commit .env.

# API
NODE_ENV=development
PORT=3000

# Local Postgres (docker-compose.yml)
# Host port defaults to 5433 so it doesn't clash with a Postgres already on 5432.
POSTGRES_USER=sonor
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sonor
POSTGRES_PORT=5433
DATABASE_URL=postgresql://sonor:change-me@localhost:5433/sonor?schema=public
